// horizonofsteel.com: static assets in ./site on the apex and www, with worker.js answering ranged requests for the
// videos under /media/ (static assets alone return the whole file, which Safari will not play).
// Deploy from this folder: npx wrangler deploy
{
  "name": "horizonofsteel",
  "main": "./worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/media/*"]
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "horizonofsteel.com", "custom_domain": true },
    { "pattern": "www.horizonofsteel.com", "custom_domain": true }
  ]
}
